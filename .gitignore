!/TenisAAA/
!/tools/
!/docs/
!/jogador_tripo_rig/
!/estadio_aaa/
!/videos_golpes/

# Unity (gerado automaticamente)
/TenisAAA/[Ll]ibrary/
/TenisAAA/[Tt]emp/
